# HiTech Store - Production Configuration
# Copy this to .env and fill in the values

# Server
NODE_ENV=production
PORT=3000

# MongoDB (use Docker internal URL in container)
MONGODB_URI=mongodb://mongodb:27017/hitechstore_v4

# JWT (IMPORTANT: Change this in production!)
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRE=72h

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Commission
COMMISSION_RATE=15

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Email (SMTP) - Optional for production
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@hitechstore.com

# ============================================
# Payment - Flouci (Tunisia)
# ============================================
FLOUCI_API_KEY=
FLOUCI_SECRET_KEY=
FLOUCI_API_URL=https://api.flouci.com/v1

# ============================================
# OAuth - Optional
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/oauth/google/callback

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_CALLBACK_URL=http://localhost:3000/api/oauth/apple/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/oauth/github/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/oauth/facebook/callback